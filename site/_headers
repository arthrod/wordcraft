/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval' 'sha256-5rX/Q1Yz5oWHJ5AQIJGVuQAwI5O8ngy1YsyuoYpSCEA='; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; worker-src 'self'; connect-src 'self'

/*.wasm
  ! Content-Type
  Content-Type: application/wasm

# Precompressed Brotli sidecars (plan §2.2). The bytes are already br-encoded wasm; a host that
# serves them verbatim must still label the payload so the browser decodes it. Requesters that
# never offer `br` never fetch these (the Worker negotiates; pages don't reference them).
/*.wasm.br
  ! Content-Type
  Content-Type: application/wasm
  Content-Encoding: br
  Vary: Accept-Encoding
  Cache-Control: public, max-age=31536000, immutable

# Brotli sidecars of the un-hashed dedicated-worker modules follow their plain files' rule
# (S4): `no-cache`, never `immutable`. Matching rules combine (a header set twice is sent
# twice, comma-joined), so every header the generic `/*.wasm.br` rule above set is detached
# here before being re-set — a joined `Content-Encoding: br, br` would make the browser
# decode the body twice.
/wordcraft-worker-*.wasm.br
  ! Content-Type
  ! Content-Encoding
  ! Vary
  ! Cache-Control
  Content-Type: application/wasm
  Content-Encoding: br
  Vary: Accept-Encoding
  Cache-Control: no-cache

# The page's first module, the viewer-first page module (plan 10.3): content-hashed by Trunk.
/wordcraft-viewer-web-*.wasm
  Cache-Control: public, max-age=31536000, immutable

/wordcraft-viewer-web-*.js
  Cache-Control: public, max-age=31536000, immutable

# The editor (wordcraft-web{.js,_loader.js,_bg.wasm}) is fetched on an edit action, by a script
# element the page module adds, so its names must be known at run time: Trunk builds it as a
# secondary target with un-hashed names. Like the workers below it is therefore `no-cache`,
# never `immutable`: one revalidation per file on a visit that edits (a 304 when unchanged).
/wordcraft-web.js
  Cache-Control: no-cache

/wordcraft-web_loader.js
  Cache-Control: no-cache

/wordcraft-web_bg.wasm
  Cache-Control: no-cache

/wordcraft-web_bg.wasm.br
  ! Content-Type
  ! Content-Encoding
  ! Vary
  ! Cache-Control
  Content-Type: application/wasm
  Content-Encoding: br
  Vary: Accept-Encoding
  Cache-Control: no-cache

# Dedicated worker artifacts (wordcraft-worker-proof{,_bg.wasm,_loader.js}): Trunk keeps
# worker names un-hashed because they must be named at runtime, so — unlike the content-hashed
# wordcraft-viewer-web-* files — they can never be `immutable` (the plan's own ground rule: immutable
# caching only on content-hashed file names). They are `no-cache`, not a short max-age window
# (S4): the hashed page module updates at once on a deploy, and a cached worker older than the
# module would fail the protocol version check for the window's whole duration — a missing
# feature, not a crash, but one the user cannot fix by reloading the module. `no-cache` costs
# one revalidation per load (a 304 when unchanged) and closes the window entirely.
/wordcraft-worker-*.js
  Cache-Control: no-cache

/wordcraft-worker-*.wasm
  Cache-Control: no-cache

/wordcraft-*.ico
  Cache-Control: public, max-age=31536000, immutable

# wasm-bindgen names a snippet `snippets/<crate>-<id>/inlineN.js`. The id comes from the crate's
# identity, not from the file's bytes, so the name can stay the same while the content changes:
# not a content hash, so never `immutable`. One revalidation per file (a 304 when unchanged).
/snippets/*
  Cache-Control: no-cache

/index.html
  Cache-Control: no-cache

/i18n/*
  Cache-Control: public, max-age=3600, must-revalidate

/samples/*
  Cache-Control: public, max-age=3600, must-revalidate

# Pack fonts have a content hash in the file name (web-assets staging).
/fonts/*.ttf.br
  Cache-Control: public, max-age=31536000, immutable

/fonts/manifest.json
  Cache-Control: no-cache
