/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; worker-src 'self'; connect-src 'self'

/*.wasm
  ! Content-Type
  Content-Type: application/wasm

# Precompressed Brotli sidecars (plan §2.2). The bytes are already br-encoded wasm; a host that
# serves them verbatim must still label the payload so the browser decodes it. Requesters that
# never offer `br` never fetch these (the Worker negotiates; pages don't reference them).
/*.wasm.br
  ! Content-Type
  Content-Type: application/wasm
  Content-Encoding: br
  Vary: Accept-Encoding
  Cache-Control: public, max-age=31536000, immutable

/wordcraft-web-*.wasm
  Cache-Control: public, max-age=31536000, immutable

/wordcraft-web-*.js
  Cache-Control: public, max-age=31536000, immutable

/wordcraft-*.ico
  Cache-Control: public, max-age=31536000, immutable

/snippets/*
  Cache-Control: public, max-age=31536000, immutable

/index.html
  Cache-Control: no-cache

/i18n/*
  Cache-Control: public, max-age=3600, must-revalidate

/samples/*
  Cache-Control: public, max-age=3600, must-revalidate

# Pack fonts have a content hash in the file name (web-assets staging).
/fonts/*.ttf.br
  Cache-Control: public, max-age=31536000, immutable

/fonts/manifest.json
  Cache-Control: no-cache
