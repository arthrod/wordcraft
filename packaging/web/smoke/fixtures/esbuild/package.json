{
  "name": "smoke-esbuild",
  "private": true,
  "type": "module",
  "dependencies": {
    "wordcraft-web": "file:../../tarball/wordcraft-web.tgz"
  },
  "devDependencies": {
    "esbuild": "latest"
  },
  "scripts": {
    "build": "esbuild src/main.js --bundle --format=esm --target=es2022 --outfile=dist/bundle.js && /bin/cp -f index.html dist/index.html"
