# Apache (see HOSTING.md). Needs mod_mime; mod_deflate and mod_headers are optional.
AddType application/wasm .wasm
AddType text/javascript .js

# Serve the precompressed <name>.wasm.br to clients that offer Brotli (plan §2.2). The .wasm
# itself stays untouched — fallback clients and Range requests get the plain asset.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTP:Accept-Encoding} \bbr\b
  RewriteCond %{HTTP:Range} !^.
  RewriteCond %{REQUEST_FILENAME}.br -f
  RewriteRule ^(.+\.wasm)$ $1.br [L]
</IfModule>

<IfModule mod_deflate.c>
  SetEnvIfNoCase Request_URI \.wasm\.br$ no-gzip
  AddOutputFilterByType DEFLATE application/wasm text/javascript text/html
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.wasm\.br$">
    Header set Content-Type "application/wasm"
    Header set Content-Encoding "br"
    Header set Vary "Accept-Encoding"
  </FilesMatch>
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(wasm|js)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  # Trunk keeps dedicated-worker names un-hashed (wordcraft-worker-proof{,_loader}.js,
  # _bg.wasm) because they must be named at runtime, so the generic rule above must not pin
  # them for a year — same exception as in packaging/web/_headers. `no-cache` (S4), not a
  # short max-age window: the hashed main module updates at once on a deploy, and a cached
  # worker older than the module would fail the protocol version check for the window's whole
  # duration. One revalidation per load (a 304 when unchanged) closes the window entirely.
  # FilesMatch blocks apply in order, so this later `Header set` overrides the generic one.
  <FilesMatch "^wordcraft-worker-.*\.(wasm|js)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "^(manifest\.json)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "\.ttf\.br$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
